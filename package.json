{
    "name": "intelligit",
    "displayName": "IntelliGit",
    "description": "IntelliJ-style Git UI for VS Code with commit graph, commit details, shelf workflow, and file change explorer.",
    "version": "0.6.2",
    "publisher": "MaheshKok",
    "icon": "media/intelligit-icon.png",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/MaheshKok/IntelliGit"
    },
    "engines": {
        "vscode": "^1.96.0"
    },
    "categories": [
        "SCM Providers"
    ],
    "keywords": [
        "git",
        "intellij",
        "intellij git",
        "pycharm",
        "pycharm git",
        "intelligent git",
        "intelligit",
        "git client",
        "git gui",
        "commit graph",
        "git graph",
        "branch manager",
        "shelf",
        "stash",
        "source control",
        "log",
        "graph",
        "scm"
    ],
    "activationEvents": [
        "onCustomEditor:intelligit.jsonPreview",
        "onStartupFinished",
        "workspaceContains:.git",
        "onView:intelligit.commitGraph",
        "onView:intelligit.commitPanel"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "icons": {
            "intelligit-implementing": {
                "description": "JetBrains-style implementing navigation",
                "default": {
                    "fontPath": "./media/navigation/navigation.woff",
                    "fontCharacter": "\\E001"
                }
            },
            "intelligit-implemented": {
                "description": "JetBrains-style implemented navigation",
                "default": {
                    "fontPath": "./media/navigation/navigation.woff",
                    "fontCharacter": "\\E002"
                }
            },
            "intelligit-overriding": {
                "description": "JetBrains-style overriding navigation",
                "default": {
                    "fontPath": "./media/navigation/navigation.woff",
                    "fontCharacter": "\\E003"
                }
            },
            "intelligit-overridden": {
                "description": "JetBrains-style overridden navigation",
                "default": {
                    "fontPath": "./media/navigation/navigation.woff",
                    "fontCharacter": "\\E004"
                }
            },
            "intelligit-recursive": {
                "description": "JetBrains-style recursive navigation",
                "default": {
                    "fontPath": "./media/navigation/navigation.woff",
                    "fontCharacter": "\\E005"
                }
            },
            "intelligit-author": {
                "description": "Code author outline",
                "default": {
                    "fontPath": "./media/author-outline.woff",
                    "fontCharacter": "\\E001"
                }
            }
        },
        "customEditors": [
            {
                "viewType": "intelligit.jsonPreview",
                "displayName": "IntelliGit JSON 预览",
                "selector": [{ "filenamePattern": "*.json" }],
                "priority": "default"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "intelligit",
                    "title": "IntelliGit",
                    "icon": "media/intelligit.svg"
                }
            ],
            "panel": [
                { "id": "intelligitTodo", "title": "TODO", "icon": "media/intelligit.svg" },
                {
                    "id": "intelligitPanel",
                    "title": "IntelliGit",
                    "icon": "media/intelligit.svg"
                }
            ]
        },
        "views": {
            "intelligitTodo": [{ "id": "intelligit.todo", "name": "", "type": "webview" }],
            "intelligit": [
                {
                    "id": "intelligit.commitPanel",
                    "name": "Commit",
                    "type": "webview"
                },
                {
                    "id": "intelligit.mergeConflicts",
                    "name": "Merge Conflicts",
                    "when": "intelligit.hasMergeConflicts"
                },
                {
                    "id": "intelligit.fileCountBadge",
                    "name": "Changes",
                    "visibility": "hidden"
                }
            ],
            "intelligitPanel": [
                {
                    "id": "intelligit.commitGraph",
                    "name": "",
                    "type": "webview"
                }
            ]
        },
        "commands": [
            { "command": "intelligit.showTodo", "title": "Show TODO", "category": "IntelliGit", "icon": "$(checklist)" },
            {
                "command": "intelligit.previewJson",
                "title": "JSON 格式化预览",
                "category": "IntelliGit",
                "icon": "$(preview)"
            },
            {
                "command": "intelligit.returnToComparison",
                "title": "返回比较",
                "category": "IntelliGit",
                "icon": "$(diff)",
                "enablement": "intelligit.canReturnToComparison"
            },
            {
                "command": "intelligit.openOverlaySource",
                "title": "在编辑器中打开源文件",
                "category": "IntelliGit",
                "icon": "$(go-to-file)"
            },
            {
                "command": "intelligit.copilotLogActions",
                "title": "管理 Copilot 调试日志…",
                "category": "IntelliGit"
            },
            {
                "command": "intelligit.clearCopilotLogs",
                "title": "清理 Copilot 历史调试日志",
                "category": "IntelliGit"
            },
            {
                "command": "intelligit.openRecentProject",
                "title": "切换最近项目…",
                "category": "IntelliGit",
                "icon": "$(folder-opened)"
            },
            {
                "command": "intelligit.showGitLog",
                "title": "Show Git Log",
                "category": "IntelliGit",
                "icon": "$(git-commit)"
            },
            {
                "command": "intelligit.refresh",
                "title": "Refresh",
                "category": "IntelliGit",
                "icon": "$(refresh)"
            },
            {
                "command": "intelligit.filterByBranch",
                "title": "Filter by Branch",
                "category": "IntelliGit"
            },
            {
                "command": "intelligit.switchRepository",
                "title": "Switch Repository",
                "category": "IntelliGit",
                "icon": "$(repo)"
            },
            {
                "command": "intelligit.refreshRepositories",
                "title": "Refresh Repositories",
                "category": "IntelliGit",
                "icon": "$(refresh)"
            },
            {
                "command": "intelligit.showBranchPopup",
                "title": "Branches...",
                "category": "IntelliGit",
                "icon": "$(git-branch)"
            },
            {
                "command": "intelligit.checkout",
                "title": "Checkout",
                "category": "IntelliGit"
            },
            {
                "command": "intelligit.newBranchFrom",
                "title": "New Branch from...",
                "category": "IntelliGit"
            },
            {
                "command": "intelligit.checkoutAndRebase",
                "title": "Checkout and Rebase onto Current",
                "category": "IntelliGit"
            },
            {
                "command": "intelligit.rebaseCurrentOnto",
                "title": "Rebase Current onto Selected",
                "category": "IntelliGit"
            },
            {
                "command": "intelligit.mergeIntoCurrent",
                "title": "Merge into Current",
                "category": "IntelliGit"
            },
            {
                "command": "intelligit.updateBranch",
                "title": "Update",
                "category": "IntelliGit"
            },
            {
                "command": "intelligit.pushBranch",
                "title": "Push",
                "category": "IntelliGit"
            },
            {
                "command": "intelligit.renameBranch",
                "title": "Rename...",
                "category": "IntelliGit"
            },
            {
                "command": "intelligit.deleteBranch",
                "title": "Delete",
                "category": "IntelliGit"
            },
            {
                "command": "intelligit.fileRollback",
                "title": "Rollback",
                "category": "IntelliGit"
            },
            {
                "command": "intelligit.fileJumpToSource",
                "title": "Jump to Source",
                "category": "IntelliGit"
            },
            {
                "command": "intelligit.fileCopyPath",
                "title": "Copy Path",
                "category": "IntelliGit"
            },
            {
                "command": "intelligit.openCommitDiffSource",
                "title": "Open in Editor",
                "category": "IntelliGit",
                "icon": "$(go-to-file)",
                "enablement": "(resourceScheme == intelligit-diff || resourceScheme == intelligit-diff-editable || resourceScheme == git) && intelligit.commitDiffSourceExists"
            },
            {
                "command": "intelligit.previousDiffFile",
                "title": "Previous IntelliGit File",
                "category": "IntelliGit",
                "icon": "$(arrow-left)"
            },
            {
                "command": "intelligit.nextDiffFile",
                "title": "Next IntelliGit File",
                "category": "IntelliGit",
                "icon": "$(arrow-right)"
            },
            {
                "command": "intelligit.fileDelete",
                "title": "Delete",
                "category": "IntelliGit"
            },
            {
                "command": "intelligit.fileShelve",
                "title": "Shelve Changes",
                "category": "IntelliGit"
            },
            {
                "command": "intelligit.fileShowHistory",
                "title": "Show History",
                "category": "IntelliGit"
            },
            {
                "command": "intelligit.compareWithRevision",
                "title": "Compare with Revision",
                "category": "IntelliGit",
                "icon": "$(git-commit)"
            },
            {
                "command": "intelligit.compareWithBranch",
                "title": "Compare with Branch",
                "category": "IntelliGit",
                "icon": "$(git-branch)"
            },
            {
                "command": "intelligit.compareProjectWithBranch",
                "title": "Compare Working Tree with Branch...",
                "category": "IntelliGit",
                "icon": "$(git-branch)"
            },
            {
                "command": "intelligit.compareCurrentBranchWithBranch",
                "title": "Compare Current Branch with Branch...",
                "category": "IntelliGit",
                "icon": "$(git-branch)"
            },
            {
                "command": "intelligit.annotateWithGitBlame",
                "title": "Annotate with Git Blame",
                "category": "IntelliGit"
            },
            {
                "command": "intelligit.clearGitBlame",
                "title": "Close Git Blame",
                "category": "IntelliGit"
            },
            {
                "command": "intelligit.commitFileCompareWithLocal",
                "title": "Compare with Local",
                "category": "IntelliGit",
                "icon": "$(diff)"
            },
            {
                "command": "intelligit.commitFileCherryPickChange",
                "title": "Cherry-pick Selected Change",
                "category": "IntelliGit",
                "icon": "$(git-commit)"
            },
            {
                "command": "intelligit.commitFileRevertChange",
                "title": "Revert Selected Change",
                "category": "IntelliGit",
                "icon": "$(discard)"
            },
            {
                "command": "intelligit.fileRefresh",
                "title": "Refresh",
                "category": "IntelliGit",
                "icon": "$(refresh)"
            },
            {
                "command": "intelligit.fileRefreshing",
                "title": "Refreshing...",
                "category": "IntelliGit",
                "icon": "$(sync~spin)",
                "enablement": "false"
            },
            {
                "command": "intelligit.openMergeConflict",
                "title": "Open Merge Conflict",
                "category": "IntelliGit",
                "icon": "$(go-to-file)"
            },
            {
                "command": "intelligit.detectJetBrainsMergeTool",
                "title": "Detect JetBrains Merge Tool",
                "category": "IntelliGit",
                "icon": "$(search)"
            },
            {
                "command": "intelligit.openMergeConflictInJetBrains",
                "title": "Open in JetBrains Merge Tool",
                "category": "IntelliGit",
                "icon": "$(link-external)"
            },
            {
                "command": "intelligit.conflictAcceptYours",
                "title": "Accept Yours",
                "category": "IntelliGit",
                "icon": "$(arrow-left)"
            },
            {
                "command": "intelligit.conflictAcceptTheirs",
                "title": "Accept Theirs",
                "category": "IntelliGit",
                "icon": "$(arrow-right)"
            },
            {
                "command": "intelligit.mergeConflictsRefresh",
                "title": "Refresh",
                "category": "IntelliGit",
                "icon": "$(refresh)"
            },
            {
                "command": "intelligit.openConflictSession",
                "title": "Open Conflict Session",
                "category": "IntelliGit",
                "icon": "$(diff-multiple)"
            },
            {
                "command": "intelligit.showBranchChanges",
                "title": "查看本分支引入的改动…",
                "category": "IntelliGit",
                "icon": "$(git-compare)"
            },
            {
                "command": "intelligit.showSelectionHistory",
                "title": "查看选中代码的历史",
                "category": "IntelliGit",
                "icon": "$(history)"
            }
        ],
        "submenus": [
            {
                "id": "intelligit.editorContext",
                "label": "IntelliGit",
                "icon": "$(git-branch)"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "command": "intelligit.previewJson",
                    "when": "resourceScheme == file && resourceExtname == .json",
                    "group": "navigation@12"
                },
                {
                    "command": "intelligit.compareProjectWithBranch",
                    "when": "resourceScheme == file",
                    "group": "navigation@9"
                },
                {
                    "command": "intelligit.compareCurrentBranchWithBranch",
                    "when": "resourceScheme == file",
                    "group": "navigation@10"
                },
                {
                    "command": "intelligit.showBranchChanges",
                    "when": "resourceScheme == file",
                    "group": "navigation@11"
                }
            ],
            "editor/context": [
                {
                    "command": "intelligit.previewJson",
                    "when": "resourceScheme == file && resourceExtname == .json",
                    "group": "navigation@12"
                },
                {
                    "submenu": "intelligit.editorContext",
                    "when": "resourceScheme == file",
                    "group": "navigation@9"
                }
            ],
            "editor/lineNumber/context": [
                {
                    "command": "intelligit.annotateWithGitBlame",
                    "when": "resourceScheme == file && intelligit.blameSupportedFile && !intelligit.blameActive",
                    "group": "navigation@1"
                },
                {
                    "command": "intelligit.clearGitBlame",
                    "when": "resourceScheme == file && intelligit.blameSupportedFile && intelligit.blameActive",
                    "group": "navigation@1"
                }
            ],
            "intelligit.editorContext": [
                {
                    "command": "intelligit.annotateWithGitBlame",
                    "when": "resourceScheme == file && intelligit.blameSupportedFile && !intelligit.blameActive",
                    "group": "1_compare@0"
                },
                {
                    "command": "intelligit.clearGitBlame",
                    "when": "resourceScheme == file && intelligit.blameSupportedFile && intelligit.blameActive",
                    "group": "1_compare@0"
                },
                {
                    "command": "intelligit.compareWithRevision",
                    "when": "resourceScheme == file",
                    "group": "1_compare@1"
                },
                {
                    "command": "intelligit.compareWithBranch",
                    "when": "resourceScheme == file",
                    "group": "1_compare@2"
                },
                {
                    "command": "intelligit.showSelectionHistory",
                    "when": "resourceScheme == file",
                    "group": "2_history@1"
                }
            ],
            "view/title": [
                {
                    "command": "intelligit.openRecentProject",
                    "when": "view == workbench.explorer.fileView",
                    "group": "navigation@0"
                },
                {
                    "command": "intelligit.refresh",
                    "when": "view == intelligit.commitGraph",
                    "group": "navigation"
                },
                {
                    "command": "intelligit.fileRefresh",
                    "when": "view == intelligit.commitPanel && !intelligit.commitPanel.refreshing",
                    "group": "navigation"
                },
                {
                    "command": "intelligit.fileRefreshing",
                    "when": "view == intelligit.commitPanel && intelligit.commitPanel.refreshing",
                    "group": "navigation"
                },
                {
                    "command": "intelligit.mergeConflictsRefresh",
                    "when": "view == intelligit.mergeConflicts",
                    "group": "navigation"
                },
                {
                    "command": "intelligit.openConflictSession",
                    "when": "view == intelligit.mergeConflicts",
                    "group": "navigation@2"
                }
            ],
            "modalEditor/editorTitle": [
                {
                    "command": "intelligit.openOverlaySource",
                    "when": "textCompareEditorActive",
                    "group": "navigation@8"
                }
            ],
            "editor/title": [
                {
                    "command": "intelligit.previewJson",
                    "when": "resourceScheme == file && resourceExtname == .json",
                    "group": "navigation@12"
                },
                {
                    "command": "intelligit.returnToComparison",
                    "when": "intelligit.canReturnToComparison",
                    "group": "navigation@5"
                },
                {
                    "command": "intelligit.previousDiffFile",
                    "when": "intelligit.diffNavigation.active && intelligit.diffNavigation.hasPrevious",
                    "group": "navigation@6"
                },
                {
                    "command": "intelligit.nextDiffFile",
                    "when": "intelligit.diffNavigation.active && intelligit.diffNavigation.hasNext",
                    "group": "navigation@7"
                },
                {
                    "command": "intelligit.openCommitDiffSource",
                    "when": "(resourceScheme == intelligit-diff || resourceScheme == intelligit-diff-editable || resourceScheme == git) && intelligit.commitDiffSourceExists",
                    "group": "navigation@8"
                }
            ],
            "view/item/context": [
                {
                    "command": "intelligit.conflictAcceptYours",
                    "when": "view == intelligit.mergeConflicts && viewItem == intelligit.conflictFile",
                    "group": "inline@1"
                },
                {
                    "command": "intelligit.conflictAcceptTheirs",
                    "when": "view == intelligit.mergeConflicts && viewItem == intelligit.conflictFile",
                    "group": "inline@2"
                },
                {
                    "command": "intelligit.openMergeConflict",
                    "when": "view == intelligit.mergeConflicts && viewItem == intelligit.conflictFile",
                    "group": "navigation@1"
                },
                {
                    "command": "intelligit.openMergeConflictInJetBrains",
                    "when": "view == intelligit.mergeConflicts && viewItem == intelligit.conflictFile",
                    "group": "navigation@2"
                },
                {
                    "command": "intelligit.conflictAcceptYours",
                    "when": "view == intelligit.mergeConflicts && viewItem == intelligit.conflictFile",
                    "group": "1_actions@1"
                },
                {
                    "command": "intelligit.conflictAcceptTheirs",
                    "when": "view == intelligit.mergeConflicts && viewItem == intelligit.conflictFile",
                    "group": "1_actions@2"
                }
            ],
            "webview/context": [
                {
                    "command": "intelligit.fileRollback",
                    "when": "webviewId == 'intelligit.commitPanel' && webviewSection == 'file'",
                    "group": "1_actions@1"
                },
                {
                    "command": "intelligit.fileRollback",
                    "when": "webviewId == 'intelligit.commitPanel' && (webviewSection == 'directory' || webviewSection == 'section')",
                    "group": "1_actions@1"
                },
                {
                    "command": "intelligit.fileJumpToSource",
                    "when": "webviewId == 'intelligit.commitPanel' && webviewSection == 'file'",
                    "group": "1_actions@2"
                },
                {
                    "command": "intelligit.fileCopyPath",
                    "when": "webviewId == 'intelligit.commitPanel' && webviewSection == 'file'",
                    "group": "1_actions@3"
                },
                {
                    "command": "intelligit.fileDelete",
                    "when": "webviewId == 'intelligit.commitPanel' && webviewSection == 'file'",
                    "group": "2_destructive@1"
                },
                {
                    "command": "intelligit.fileShelve",
                    "when": "webviewId == 'intelligit.commitPanel' && webviewSection == 'file'",
                    "group": "2_destructive@2"
                },
                {
                    "command": "intelligit.fileShowHistory",
                    "when": "webviewId == 'intelligit.commitPanel' && webviewSection == 'file'",
                    "group": "3_info@1"
                },
                {
                    "command": "intelligit.fileRefresh",
                    "when": "webviewId == 'intelligit.commitPanel' && !intelligit.commitPanel.refreshing",
                    "group": "3_info@2"
                },
                {
                    "command": "intelligit.commitFileCompareWithLocal",
                    "when": "(webviewId == 'intelligit.commitGraph' || webviewId == 'intelligit.commitFiles') && webviewSection == 'commitInfoFile'",
                    "group": "1_compare@1"
                },
                {
                    "command": "intelligit.commitFileCherryPickChange",
                    "when": "(webviewId == 'intelligit.commitGraph' || webviewId == 'intelligit.commitFiles') && webviewSection == 'commitInfoFile'",
                    "group": "2_apply@1"
                },
                {
                    "command": "intelligit.commitFileRevertChange",
                    "when": "(webviewId == 'intelligit.commitGraph' || webviewId == 'intelligit.commitFiles') && webviewSection == 'commitInfoFile'",
                    "group": "2_apply@2"
                }
            ]
        },
        "keybindings": [
            {
                "command": "intelligit.showGitLog",
                "key": "alt+9",
                "mac": "alt+9"
            }
        ],
        "configurationDefaults": {
            "[go]": {
                "editor.codeLensFontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
                "editor.inlayHints.fontSize": 11,
                "editor.inlayHints.fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
            }
        },
        "configuration": {
            "title": "IntelliGit",
            "properties": {
                "intelligit.todo.highlight": { "type": "boolean", "default": true, "description": "Highlight TODO and FIXME comments in source files." },
                "intelligit.symbolInsights.enabled": {
                    "type": "boolean",
                    "default": true,
                    "scope": "resource",
                    "description": "Show reference counts and Git authors above function, method, type, constant and package variable declarations. Click to peek references or toggle the file’s Git blame annotations. Requires editor.codeLens. Uses document symbols from the language extension; skips files over 20,000 lines or 1 MiB of text."
                },
                "intelligit.diff.openInOverlay": {
                    "type": "boolean",
                    "default": true,
                    "scope": "window",
                    "markdownDescription": "Automatically open native file diffs in a large overlay in the current project window. Press Escape to return. Applies to IntelliGit and other file diff entry points. Requires a VS Code host with modal editors and `workbench.editor.useModal` set to `some` or `all`; older hosts keep regular editor tabs. Disable to use normal diff tabs."
                },
                "intelligit.log.showAllRefs": {
                    "type": "boolean",
                    "default": false,
                    "scope": "window",
                    "markdownDescription": "Include all Git references in the commit graph when viewing all branches, including Copilot/Agent checkpoints and other internal snapshots. By default, show only local branches, remote branches, tags, and HEAD. Changing this setting refreshes the graph automatically."
                },
                "intelligit.copilotPerformance.enabled": {
                    "type": "boolean",
                    "default": false,
                    "scope": "window",
                    "markdownDescription": "Show the latest completed Copilot LLM request's tokens/s, TTFT and model in the right status bar. Hidden by default. When enabled, watches local Copilot debug logs and automatically removes historical logs after 7 days or above a 100 MB target, protecting the newest session and logs updated within 24 hours. Use IntelliGit: 管理 Copilot 调试日志 to enable or disable file logging, or clean historical logs, even while the status bar is hidden."
                },
                "intelligit.pipeline.providers": {
                    "type": "array",
                    "default": [],
                    "scope": "application",
                    "markdownDescription": "Git services used to read commit CI status. Configure in User Settings. Only matching remotes with a non-empty token are queried. Tokens are stored as plain text in this setting. GitLab needs `read_api`; GitHub fine-grained tokens need repository Checks and Commit statuses read access.",
                    "items": {
                        "type": "object",
                        "required": ["type", "url", "token"],
                        "additionalProperties": false,
                        "properties": {
                            "type": { "type": "string", "enum": ["github", "gitlab"] },
                            "url": { "type": "string", "description": "HTTPS service URL, e.g. https://github.com or https://gitlab.company.com." },
                            "token": { "type": "string", "description": "Access token for this service instance." }
                        }
                    }
                },
                "intelligit.jetbrainsMergeTool.path": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "JetBrains IDE binary path/command (`pycharm`, `idea`, `webstorm`) or a macOS `.app` bundle path. IntelliGit auto-resolves `.app` bundles to the executable inside `Contents/MacOS`."
                },
                "intelligit.jetbrainsMergeTool.preferExternal": {
                    "type": "boolean",
                    "default": false,
                    "markdownDescription": "Opt in to opening merge conflicts with the external JetBrains merge tool by default. When disabled, IntelliGit opens its built-in IDEA-style merge editor; the external tool remains available from the conflict file context menu."
                },
                "intelligit.goRelationships.enabled": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Show clickable Go interface, embedded-method and recursive-call icons above visible declarations. Hover an icon for its meaning and target count. Requires the Go language server and editor.codeLens."
                },
                "intelligit.clearLastCommit": {
                    "type": "boolean",
                    "default": true,
                    "scope": "window",
                    "markdownDescription": "Clear the commit message after a successful commit. Disable this setting to keep the submitted message in the commit input."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "node scripts/build.js --production",
        "build": "node scripts/build.js",
        "build:prod": "node scripts/build.js --production",
        "watch": "node scripts/watch.js",
        "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.js\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.js\"",
        "lint": "eslint src",
        "typecheck:ext": "tsc -p tsconfig.json --noEmit",
        "typecheck:webview": "tsc -p tsconfig.webview.json --noEmit",
        "typecheck": "bun run typecheck:ext && bun run typecheck:webview",
        "test": "bun vitest run",
        "test:go-relationships": "node scripts/test-go-relationships.cjs",
        "test:diff-overlay": "node scripts/test-diff-overlay.cjs",
        "test:coverage": "bun vitest run --coverage",
        "test:watch": "bun vitest",
        "package": "vsce package --no-dependencies",
        "publish": "vsce publish --no-dependencies"
    },
